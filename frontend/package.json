    "react-router": "^8.5.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.6",
